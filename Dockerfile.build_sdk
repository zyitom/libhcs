FROM zyi024424/libhcs-ci AS build

SHELL ["/bin/bash", "-c"]

# The SDK ships as source: libhcs-sdk-src-<version>.zip, which a project pulls with FetchContent
# and builds with its own compiler (README.md). .scripts/package_sdk_source is the one
# definition of that zip; CI's lint job runs the same script.
WORKDIR /src-full
RUN --mount=type=bind,target=/src-full,source=.,readonly \
    .scripts/package_sdk_source /output

# Build the zip once the way a project does, so a release never carries one that does not build.
RUN mkdir /check && cd /check \
    && cmake -E tar xf /output/libhcs-sdk-src-*.zip \
    && cmake -S libhcs-sdk-src-* -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build \
    && cd / && rm -rf /check

FROM scratch AS output
COPY --from=build /output/ /

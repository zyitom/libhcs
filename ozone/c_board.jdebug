/*********************************************************************
* Ozone project: c_board BOOTLOADER -- STM32F407IGH6, SWD.
*
*   /opt/SEGGER/Ozone_V350a/Ozone ozone/c_board.jdebug
*   ./ozone-debug.sh c_board
*
* Build first:
*   cmake --build firmware/c_board/build --target c_board_bootloader
*
* Bootloader rather than application, and download-and-reset rather than attach:
* same reasoning as ozone/mc02.jdebug -- the app is deployed over DFU
* (./flash-cboard.sh), and the bootloader is only observable from reset because
* it hands over to the app within milliseconds.
*
* To debug the running APPLICATION instead, change File.Open to
* ../firmware/c_board/build/app/c_board_app.elf AND the connect mode to
* CM_ATTACH_HALT.
**********************************************************************/

void OnProjectLoad (void) {
  Project.SetDevice ("STM32F407IGHx");
  Project.SetHostIF ("USB", "0");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("4 MHz");

  Debug.SetConnectMode (CM_DOWNLOAD_RESET);

  File.Open ("../firmware/c_board/build/bootloader/c_board_bootloader.elf");
}
